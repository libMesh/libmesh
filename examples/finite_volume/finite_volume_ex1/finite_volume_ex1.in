# The number of hexagons along each direction of the coarsest mesh
coarse_grid_size = 4

# The maximum number of times the coarse grid size is doubled while
# waiting for the measured convergence rate to approach 2
max_refinements = 6

# The diffusion coefficient
diffusivity = 1

# The components of the constant advecting velocity
velocity_x = 1
velocity_y = 0.5
